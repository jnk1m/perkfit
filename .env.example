# Copy to .env.local. Never commit .env.local.
# Qloo hackathon key (server only). Without it the app runs in sample mode with synthetic numbers.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Anthropic key for the agent loop and explanations (server only). Without it, explanations are plain fact sentences.
ANTHROPIC_API_KEY=
# Model id used by the agent (default claude-opus-5-5)
PERKFIT_LLM_MODEL=
# "live" (default) or "sample"
PERKFIT_MODE=
# Precomputed example results (base64 gzip JSON). Generated by `npm run precache`, stored only in Vercel env.
PERKFIT_PRECACHE=
# Upstash Redis for daily quotas (optional; without it custom live runs are disabled)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32+ random bytes (hex). Encrypts chip tokens so Qloo entity ids never reach the browser in clear text.
PERKFIT_SECRET=
